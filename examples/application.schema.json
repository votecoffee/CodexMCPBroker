{
  "$defs": {
    "BackendPublication": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "title": "Revision",
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/ServiceManifest"
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkerArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "revision",
        "service"
      ],
      "title": "BackendPublication",
      "type": "object"
    },
    "CapabilityProvider": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "title": "Tool",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "tool"
      ],
      "title": "CapabilityProvider",
      "type": "object"
    },
    "HttpTransport": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "streamable-http",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "bearer_token_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bearer Token Env"
        },
        "max_sse_event_bytes": {
          "anyOf": [
            {
              "maximum": 134217728,
              "minimum": 1024,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Sse Event Bytes"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "title": "HttpTransport",
      "type": "object"
    },
    "ServiceManifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 2048,
          "title": "Description",
          "type": "string"
        },
        "transport": {
          "discriminator": {
            "mapping": {
              "stdio": "#/$defs/StdioTransport",
              "streamable-http": "#/$defs/HttpTransport"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/HttpTransport"
            },
            {
              "$ref": "#/$defs/StdioTransport"
            }
          ],
          "title": "Transport"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "allow_writes": {
          "default": false,
          "title": "Allow Writes",
          "type": "boolean"
        },
        "allowed_write_tools": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[A-Za-z0-9_.-]{1,128}$",
                "type": "string"
              },
              "maxItems": 2000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Write Tools"
        },
        "read_only_tools": {
          "items": {
            "type": "string"
          },
          "title": "Read Only Tools",
          "type": "array"
        },
        "max_argument_bytes": {
          "default": 262144,
          "maximum": 67108864,
          "minimum": 1,
          "title": "Max Argument Bytes",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 20.0,
          "maximum": 300.0,
          "minimum": 0.2,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "session_mode": {
          "default": "transient",
          "enum": [
            "transient",
            "exclusive",
            "shared"
          ],
          "title": "Session Mode",
          "type": "string"
        },
        "lease_seconds": {
          "default": 900.0,
          "maximum": 86400.0,
          "minimum": 5.0,
          "title": "Lease Seconds",
          "type": "number"
        },
        "resource_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Id"
        },
        "capability_catalog": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityProvider"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "protocol_mode": {
          "default": "legacy",
          "enum": [
            "legacy",
            "auto",
            "2026-07-28"
          ],
          "title": "Protocol Mode",
          "type": "string"
        },
        "discovery_cache_ttl_seconds": {
          "default": 0.0,
          "maximum": 60,
          "minimum": 0,
          "title": "Discovery Cache Ttl Seconds",
          "type": "number"
        },
        "watch_catalog": {
          "default": false,
          "title": "Watch Catalog",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "display_name",
        "transport"
      ],
      "title": "ServiceManifest",
      "type": "object"
    },
    "StdioTransport": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "stdio",
          "title": "Type",
          "type": "string"
        },
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "cwd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        },
        "env_vars": {
          "items": {
            "type": "string"
          },
          "title": "Env Vars",
          "type": "array"
        }
      },
      "required": [
        "type",
        "command"
      ],
      "title": "StdioTransport",
      "type": "object"
    },
    "WorkerArtifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "WorkerArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "display_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "instructions": {
      "default": "",
      "maxLength": 4096,
      "title": "Instructions",
      "type": "string"
    },
    "backends": {
      "items": {
        "$ref": "#/$defs/BackendPublication"
      },
      "maxItems": 32,
      "title": "Backends",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "display_name"
  ],
  "title": "ApplicationDefinition",
  "type": "object"
}
