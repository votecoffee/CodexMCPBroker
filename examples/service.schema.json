{
  "$defs": {
    "CapabilityProvider": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "title": "Tool",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "tool"
      ],
      "title": "CapabilityProvider",
      "type": "object"
    },
    "HttpTransport": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "streamable-http",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "bearer_token_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bearer Token Env"
        },
        "allow_remote": {
          "default": false,
          "title": "Allow Remote",
          "type": "boolean"
        },
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/OAuthServiceSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_sse_event_bytes": {
          "anyOf": [
            {
              "maximum": 134217728,
              "minimum": 1024,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Sse Event Bytes"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "title": "HttpTransport",
      "type": "object"
    },
    "OAuthServiceSettings": {
      "additionalProperties": false,
      "properties": {
        "token_endpoint": {
          "title": "Token Endpoint",
          "type": "string"
        },
        "client_id": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Client Id",
          "type": "string"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Scopes",
          "type": "array"
        },
        "client_secret_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret Env"
        },
        "assertion_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assertion Env"
        },
        "dpop_key_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dpop Key Env"
        }
      },
      "required": [
        "token_endpoint",
        "client_id"
      ],
      "title": "OAuthServiceSettings",
      "type": "object"
    },
    "StdioTransport": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "stdio",
          "title": "Type",
          "type": "string"
        },
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "cwd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        },
        "env_vars": {
          "items": {
            "type": "string"
          },
          "title": "Env Vars",
          "type": "array"
        }
      },
      "required": [
        "type",
        "command"
      ],
      "title": "StdioTransport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "display_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 2048,
      "title": "Description",
      "type": "string"
    },
    "transport": {
      "discriminator": {
        "mapping": {
          "stdio": "#/$defs/StdioTransport",
          "streamable-http": "#/$defs/HttpTransport"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/HttpTransport"
        },
        {
          "$ref": "#/$defs/StdioTransport"
        }
      ],
      "title": "Transport"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "allow_writes": {
      "default": false,
      "title": "Allow Writes",
      "type": "boolean"
    },
    "allowed_write_tools": {
      "anyOf": [
        {
          "items": {
            "pattern": "^[A-Za-z0-9_.-]{1,128}$",
            "type": "string"
          },
          "maxItems": 2000,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Allowed Write Tools"
    },
    "read_only_tools": {
      "items": {
        "type": "string"
      },
      "title": "Read Only Tools",
      "type": "array"
    },
    "max_argument_bytes": {
      "default": 262144,
      "maximum": 67108864,
      "minimum": 1,
      "title": "Max Argument Bytes",
      "type": "integer"
    },
    "max_argument_depth": {
      "default": 64,
      "maximum": 128,
      "minimum": 1,
      "title": "Max Argument Depth",
      "type": "integer"
    },
    "max_argument_nodes": {
      "default": 100000,
      "maximum": 1000000,
      "minimum": 1,
      "title": "Max Argument Nodes",
      "type": "integer"
    },
    "timeout_seconds": {
      "default": 20.0,
      "maximum": 300.0,
      "minimum": 0.2,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "session_mode": {
      "default": "transient",
      "enum": [
        "transient",
        "exclusive",
        "shared"
      ],
      "title": "Session Mode",
      "type": "string"
    },
    "lease_seconds": {
      "default": 900.0,
      "maximum": 86400.0,
      "minimum": 5.0,
      "title": "Lease Seconds",
      "type": "number"
    },
    "resource_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Id"
    },
    "capability_catalog": {
      "anyOf": [
        {
          "$ref": "#/$defs/CapabilityProvider"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "protocol_mode": {
      "default": "legacy",
      "enum": [
        "legacy",
        "auto",
        "2026-07-28"
      ],
      "title": "Protocol Mode",
      "type": "string"
    },
    "discovery_cache_ttl_seconds": {
      "default": 0.0,
      "maximum": 60,
      "minimum": 0,
      "title": "Discovery Cache Ttl Seconds",
      "type": "number"
    },
    "watch_catalog": {
      "default": false,
      "title": "Watch Catalog",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "display_name",
    "transport"
  ],
  "title": "ServiceManifest",
  "type": "object"
}
